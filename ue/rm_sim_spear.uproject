        },
        {
            "Name": "RmSimSpearMetadata",
            "Enabled": true
        }
    ],
    "AdditionalPluginDirectories": [
        "../../spear/cpp/unreal_plugins"
    ],
    "TargetPlatforms": ["Linux", "Windows"]
}
